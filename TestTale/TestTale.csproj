<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
	<WarningsAsErrors>1591</WarningsAsErrors>
	<PackageId>TestTale</PackageId>
	<Version>1.0.0</Version>
	<Authors>Aleksey Luzanov</Authors>
	<Company>Aleksey Luzanov</Company>
	<Description>Make your tests as a tale</Description>
	<PackageTags>test;unit test</PackageTags>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageOutputPath>C:\NuGetLocal</PackageOutputPath>
  	<RepositoryUrl>https://github.com/AleeexWind/TestTale</RepositoryUrl>
 	<RepositoryType>git</RepositoryType>

  	<PackageLicenseExpression>MIT</PackageLicenseExpression>
  	<PackageReadmeFile>README.md</PackageReadmeFile>
  	<PackageProjectUrl>https://github.com/AleeexWind/TestTale</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
